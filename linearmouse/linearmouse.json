{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.12.0",
  "schemes" : [
    {
      "buttons" : {
        "universalBackForward" : true
      },
      "if" : {
        "device" : {
          "category" : "mouse"
        }
      },
      "pointer" : {
        "acceleration" : 1,
        "disableAcceleration" : true,
        "speed" : 0.5
      },
      "scrolling" : {
        "acceleration" : {
          "vertical" : 1
        },
        "distance" : {
          "vertical" : "128px"
        },
        "modifiers" : {
          "vertical" : {
            "shift" : {
              "type" : "alterOrientation"
            }
          }
        },
        "reverse" : {
          "vertical" : true
        },
        "smoothed" : {
          "vertical" : {
            "enabled" : false
          }
        },
        "speed" : {
          "vertical" : 0
        }
      }
    },
    {
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0xc539",
          "productName" : "USB Receiver",
          "vendorID" : "0x46d"
        }
      },
      "logitech" : {
        "highResolutionWheel" : false
      }
    }
  ]
}